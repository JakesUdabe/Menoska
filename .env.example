NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Menoska Consulting Supabase project: https://nheyqairforzviwheyrq.supabase.co
# mc_* tables: mc_organizations, mc_profiles, mc_bulletins (+ sections/recipients/deliveries),
# mc_intelligence_reports, mc_report_templates, mc_worksheets, mc_organization_invites,
# mc_projects, mc_project_links, mc_activity_events, mc_ai_usage_events, mc_deletion_requests.
# Also: contact_leads (marketing form). Do NOT use Proposalyze public.profiles / organizations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth emails (Resend). Supabase Auth SMTP on nhey uses the same key and sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Menoska Consulting <noreply@menoska-consulting.com>

# Apollo and Smartlead are Edge secrets for a later deploy on nhey.
# The Next app does not read them. Leave empty until the keys exist for this project.
# Optional later: WEBHOOK_SECRET (outreach-reply), INSTANTLY_API_KEY.
APOLLO_API_KEY=
SMARTLEAD_API_KEY=

# Stripe (Billing APIs + Checkout Sessions). Price ids are not secret; keys are.
# STRIPE_SECRET_KEY is also the secret for the edge function menoska-get-stripe-financials.
# Live account acct_1TBIFCF3yyKUpy6t. See docs/STRIPE.md.
STRIPE_SECRET_KEY=
# Checkout is created on the server, so no publishable key.
# The live webhook secret is STRIPE_WEBHOOK_SECRET_MENOSKA on Supabase, not in this file.
STRIPE_PRICE_STARTER_MONTHLY=price_1UZZ89F3yyKUpy6txpLvpy9g
STRIPE_PRICE_STARTER_YEARLY=price_1UZZ8AF3yyKUpy6tsnxDbrVT
STRIPE_PRICE_BUSINESS_MONTHLY=price_1UZZ8BF3yyKUpy6t33qnYHX1
STRIPE_PRICE_BUSINESS_YEARLY=price_1UZZ8DF3yyKUpy6tuDLcOznL
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_1UZZ8EF3yyKUpy6t3TdUtVg4
STRIPE_PRICE_ENTERPRISE_YEARLY=price_1UZZ8GF3yyKUpy6t1KTE1avw
STRIPE_PRICE_ADDON_SEATS=price_1UZZ8HF3yyKUpy6tfs6USk11
STRIPE_PRICE_ADDON_SENDS=price_1UZZ8NF3yyKUpy6t7NjbUtOJ
# Edge only. Do not expose as NEXT_PUBLIC_ or VITE_.
# STRIPE_PRICE_FAKTURABAI_TEST=price_1UWIJHF3yyKUpy6tMLQyWgMw
# STRIPE_WEBHOOK_SECRET_MENOSKA=  (Supabase Edge; do not reuse the Proposalyze webhook secret)

# AI engine. This deployment uses OpenAI. Anthropic or Gemini are optional fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Edge function menoska-sync-openai-costs (Supabase secret, not NEXT_PUBLIC_).
# Optional: OPENAI_PROJECT_ID, OPENAI_ORG_ID, OPENAI_EUR_USD_RATE (default 0.92).
OPENAI_ADMIN_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Patents. EPO OPS is the source for publication search, FTO and state-of-the-art reports.
# Free registration: https://www.epo.org/en/searching-for-patents/data/web-services/ops
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Optional. Used only when EPO returns nothing.
LENS_API_TOKEN=

# Superadmin bootstrap (first user with this email becomes superadmin)
SUPERADMIN_EMAIL=

# Org invites: table mc_organization_invites (see supabase/migrations/20261026200000_mc_organization_invites.sql).
# In demo mode invites live in localStorage key menoska_invites; accept creates a demo account under the org.

# Web search for bulletin news and the market-report evidence pass.
# One key is enough. Tavily is used first for bulletins and also feeds market-report snippets.
# Brave is news-only and is used for bulletins only when Tavily is empty.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
