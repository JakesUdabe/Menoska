# Copy to infra/.env on the VM. Do not commit the filled file.
# NIF, issuer name and PFX password live only in that VM file.
# The invoice issuer is the autónomo, not the Menoska brand.

FAKTURABAI_ENV=test
FAKTURABAI_DRY_RUN=true
FAKTURABAI_STANDBY=true
FAKTURABAI_SEND_EMAIL=false
FAKTURABAI_SERIE=MK
FAKTURABAI_PFX_PATH=/run/secrets/fakturabai/autonomo.p12
FAKTURABAI_CONTEXT=../../fakturabai
FAKTURABAI_SECRETS_HOST=./secrets/fakturabai
FAKTURABAI_SOFTWARE_LICENSE=TBAIGIPRE00000001301
FAKTURABAI_SOFTWARE_NAME=Menoska FakturaBAI
